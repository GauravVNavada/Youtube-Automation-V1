{
  "name": "modular-shorts-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Electron desktop shell for Modular Shorts Studio",
  "homepage": "https://modularshorts.local",
  "author": {
    "name": "Modular Shorts Studio",
    "email": "support@modularshorts.local"
  },
  "main": "electron/main.js",
  "scripts": {
    "prepare:desktop-ui": "node electron/prepare-ui.js",
    "predev": "npm run prepare:desktop-ui",
    "dev": "env -u ELECTRON_RUN_AS_NODE ELECTRON_DISABLE_GPU=1 electron .",
    "prestart": "npm run prepare:desktop-ui",
    "start": "env -u ELECTRON_RUN_AS_NODE ELECTRON_DISABLE_GPU=1 electron .",
    "predesktop:pack": "npm run prepare:desktop-ui",
    "desktop:pack": "electron-builder --dir",
    "predesktop:dist:linux": "npm run prepare:desktop-ui",
    "desktop:dist:linux": "electron-builder --linux AppImage deb",
    "predesktop:dist:win": "npm run prepare:desktop-ui",
    "desktop:dist:win": "electron-builder --win zip",
    "predesktop:dist": "npm run prepare:desktop-ui",
    "desktop:dist": "electron-builder --linux AppImage deb --win zip",
    "playground": "python3 -m http.server 3001 --directory ../playground/ui/dist"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.modularshorts.studio",
    "productName": "Modular Shorts Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "maintainer": "Modular Shorts Studio <support@modularshorts.local>"
    },
    "win": {
      "target": [
        "zip"
      ]
    }
  }
}
