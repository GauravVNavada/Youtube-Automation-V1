{
  "name": "modular-shorts-desktop-app",
  "version": "0.1.0",
  "private": true,
  "description": "Paid Electron desktop app for Modular Shorts Studio",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "prestart": "npm run build",
    "start": "env -u ELECTRON_RUN_AS_NODE ELECTRON_DISABLE_GPU=1 electron .",
    "predesktop:pack": "npm run build",
    "desktop:pack": "electron-builder --dir",
    "predesktop:dist:linux": "npm run build",
    "desktop:dist:linux": "electron-builder --linux AppImage deb",
    "predesktop:dist:win": "npm run build",
    "desktop:dist:win": "electron-builder --win zip"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "lucide-react": "^1.21.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "vite": "^8.0.16"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "typescript": "^6.0.3"
  },
  "build": {
    "appId": "com.modularshorts.paiddesktop",
    "productName": "Modular Shorts Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "AudioVideo",
      "maintainer": "Modular Shorts Studio <support@modularshorts.local>"
    },
    "win": {
      "target": ["zip"]
    }
  }
}
