APP_PORT=8080
ADMINER_PORT=8081

POSTGRES_USER=desktopapp
POSTGRES_PASSWORD=change-this-postgres-password
POSTGRES_DB=desktopapp

PLAYGROUND_POSTGRES_USER=playground
PLAYGROUND_POSTGRES_PASSWORD=change-this-playground-password
PLAYGROUND_POSTGRES_DB=playground
PLAYGROUND_CORS_ORIGINS=http://localhost:8080

JWT_SECRET=change-this-long-random-secret
ACCESS_TOKEN_MINUTES=10080
CORS_ORIGINS=http://localhost:8080
WORKER_CONCURRENCY=3

LLM_PROVIDER=auto
LLM_MODEL=
LLM_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
# Compatibility alias: comma-separated Gemini keys. Prefer GEMINI_API_KEY for new installs.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash

PEXELS_API_KEY=
PIXABAY_API_KEY=

# Mount a service account file at ./secrets/google-tts.json.
GOOGLE_TTS_CREDENTIALS=/app/secrets/google-tts.json
# Local/non-Docker compatibility alias for GOOGLE_TTS_CREDENTIALS.
TTS_CREDENTIALS_PATH=
